+                    .unwrap();
+                assert_eq!(state_name(&commit.ring.entries[0]), "Deferred");
+                assert_eq!(&request[40..], b"hello\0");
+                // A stale handle for an earlier fetch is refused before its closure runs
+                let stale = RingCommit {
+                    ring: Arc::clone(&commit.ring),
+                    idx: 0,
+                    commit_id: 50,
