+        assert_eq!(u64_at(&after, 16), 0x1122_3344_5566_7788, "addr");
+        assert_eq!(u64_at(&after, 32), 0x0102_0304_0506_0708, "user_data");
+        assert_eq!(&after[48..128], &[0xAB; 80][..], "cmd");
+    }
