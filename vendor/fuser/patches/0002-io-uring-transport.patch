+    /// Submits the queue and waits for one CQE; `timed` bounds the wait to 10 ms.
+    fn submit_and_wait(&mut self, timed: bool) -> io::Result<usize> {
+        if !self.early.is_empty() {
+            return self.submit();
+        }
+        match &mut self.io {
