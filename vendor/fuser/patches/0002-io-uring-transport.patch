+    fn submit(&mut self) -> io::Result<usize> {
+        #[cfg(test)]
+        self.hooks.before_submit()?;
+        match &mut self.io {
+            Backend::Kernel(io) => io.submit(),
+            Backend::Memory(m) => m.submit(),
+        }
+    }
