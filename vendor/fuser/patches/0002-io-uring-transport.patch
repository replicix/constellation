+        let e = &ring.entries[0];
+        let commit = fake_dispatched(&ring, 0, 61);
+        let unwound = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            commit.fill(8, |buf| -> Result<usize, Errno> {
