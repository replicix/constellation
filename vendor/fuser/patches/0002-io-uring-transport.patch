+            assert_eq!(state_name(e), "Pending");
+            assert_eq!(reply_fields(e), (16 + 4, 0, 51, 4));
+            assert_eq!(payload_bytes(e, 4), b"abcd");
+            let live = ring.live.lock();
+            assert_eq!((live.in_kernel, live.outstanding), (1, 0));
+            assert_eq!(live.pending, [0]);
