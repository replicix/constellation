+        assert_not_mounted(&m.mountpoint);
+        // The host is fine; the same mountpoint takes a ring session at once
+        let bg = m
+            .session(RingFs::default(), &ring_config())
+            .spawn()
+            .unwrap();
+        assert_eq!(std::fs::read(m.path("hello.txt")).unwrap(), HELLO);
