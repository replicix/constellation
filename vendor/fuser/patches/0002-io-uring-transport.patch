+            .fill(8, |buf| {
+                buf[..3].copy_from_slice(b"abc");
+                Ok(8)
+            })
+            .unwrap();
+        assert_eq!(reply_fields(e), (16 + 8, 0, 42, 8));
+        assert_eq!(payload_bytes(e, 8), b"abc\0\0\0\0\0");
