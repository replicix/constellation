+    /// The filesystem is still destroyed exactly once and unmounted
+    #[test]
+    fn panic_in_callback_ends_the_session() {
+        struct PanicFs(Arc<std::sync::atomic::AtomicUsize>);
+        impl Filesystem for PanicFs {
