+/// An SQE as the 128 bytes the kernel reads.
+pub(crate) fn sqe_bytes(sqe: squeue::Entry128) -> [u8; 128] {
+    // SAFETY: as in `set_sqe_len`.
+    unsafe { std::mem::transmute(sqe) }
+}
