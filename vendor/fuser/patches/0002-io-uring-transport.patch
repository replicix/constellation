+    pub(crate) fn uring(&mut self) -> &mut IoUring<squeue::Entry128, cqueue::Entry> {
+        match &mut self.io {
+            Backend::Kernel(io) => io,
+            Backend::Memory(_) => panic!("not a kernel io_uring"),
+        }
+    }
