+    /// `EINVAL` a kernel before 6.1 that lacks the setup flags.
+    pub(crate) fn open(sq_entries: u32, cq_entries: u32) -> io::Result<Self> {
+        let io = IoUring::<squeue::Entry128, cqueue::Entry>::builder()
+            .dontfork()
+            .setup_submit_all()
+            .setup_cqsize(cq_entries)
+            .setup_single_issuer()
+            .setup_defer_taskrun()
+            .setup_r_disabled()
+            .build(sq_entries)?;
