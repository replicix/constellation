#!/usr/bin/env bash
# xfstests FUSE mount helper.  xfstests supplies the backend and state
# directory as mount options because TEST_DEV itself is only a label.
set -euo pipefail
source_dev=$1
mountpoint=$2
shift 2

options=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o) options="${2:-}"; shift 2 ;;
        -o*) options="${1#-o}"; shift ;;
        *) shift ;;
    esac
done

backend=
state=
IFS=, read -ra opts <<<"$options"
for opt in "${opts[@]}"; do
    case "$opt" in
        source=*) backend="${opt#source=}" ;;
        state=*) state="${opt#state=}" ;;
    esac
done
[ -n "$backend" ] || { echo "source= backend missing for $source_dev" >&2; exit 2; }
[ -n "$state" ] || state="/tmp/constellation-xfstests-${source_dev}"
mkdir -p "$state" "$mountpoint"

if [ "${CONSTELLATION_DIRECT_MOUNT:-0}" = 1 ]; then
    /usr/local/bin/constellation mount --s3 "$backend" "$mountpoint" \
        --state-dir "$state" --allow-other --fs-name "$source_dev" \
        >"$state/mount.log" 2>&1 &
    pid=$!
    for _ in $(seq 1 100); do
        mountpoint -q "$mountpoint" && exit 0
        kill -0 "$pid" 2>/dev/null || { wait "$pid"; exit $?; }
        sleep 0.1
    done
    echo "constellation mount did not appear: $mountpoint" >&2
    exit 1
fi

pid=$(python3 - "$backend" "$mountpoint" "$state" "$source_dev" <<'PY'
import subprocess
import sys

log = open(sys.argv[3] + "/mount.log", "wb")
process = subprocess.Popen(
    ["/usr/local/bin/constellation", "mount", "--s3", sys.argv[1], sys.argv[2],
     "--state-dir", sys.argv[3], "--allow-other", "--fs-name", sys.argv[4]],
    stdin=subprocess.DEVNULL,
    stdout=log,
    stderr=subprocess.STDOUT,
    close_fds=True,
    start_new_session=True,
)
print(process.pid)
PY
)
# mount(8) holds a per-target helper lock until this process exits. The
# detached daemon completes the FUSE mount immediately after that lock drops;
# xfstests performs its own mounted-filesystem verification.
exit 0
